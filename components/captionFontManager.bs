' captionFontManager.bs
' Manages Ocelotl packaged font selection based on user preferences
' and automatic fallback to system fonts for characters not covered by Ocelotl.

' Maps Roku font preference to Ocelotl family name
function getPackagedFontFamily(textFont as string) as string
    if textFont = "Small caps"
        return "OcelotlSansSmallCaps"
    else if textFont = "Serif proportional" or textFont = "Casual" or textFont = "Cursive" or textFont = "Default"
        return "OcelotlSerif"
    else if textFont = "Serif fixed width" or textFont = "Sans serif fixed width"
        return "OcelotlMono"
    else if textFont = "Sans serif proportional"
        return "OcelotlSans"
    end if

    print ">>> Unknown font preference: [" + textFont + "], using default OcelotlSans"
    return "OcelotlSans"
end function

' Returns font URIs for a given Ocelotl family
function getPackagedFonts(family as string) as object
    fonts = {
        "regular": `pkg:/fonts/${family}-Regular.ttf`,
        "bold": `pkg:/fonts/${family}-Bold.ttf`,
        "italic": `pkg:/fonts/${family}-Italic.ttf`,
        "bolditalic": `pkg:/fonts/${family}-BoldItalic.ttf`
    }

    if family = "OcelotlMono" or family = "OcelotlSansSmallCaps" or family = "OcelotlSans"
        fonts.italic = fonts.regular
        fonts.bolditalic = fonts.bold
    end if

    return fonts
end function

' Measures line heights for given fonts using "Ag" sample text
function measureLineHeights(fonts as object, fontSize as integer, textColor as string, isHD as boolean, topNode as object) as object
    tempGroup = CreateObject("roSGNode", "Group")
    testLabel = CreateObject("roSGNode", "MultiStyleLabel")
    testLabel.drawingStyles = {
        "default": {
            "fontUri": fonts.regular,
            "fontSize": fontSize,
            "color": textColor
        }
    }
    tempGroup.appendChild(testLabel)
    topNode.appendChild(tempGroup)

    ' Measure single line
    testLabel.text = "Ag"
    single = Int(testLabel.boundingRect().height)

    ' Measure two lines
    testLabel.text = "Ag" + chr(10) + "Ag"
    multi = Int(testLabel.boundingRect().height) - single

    topNode.removeChild(tempGroup)

    ' Round to multiples of 3 on HD devices for pixel-perfect alignment
    if isHD
        while single mod 3 <> 0
            single++
        end while
        while multi mod 3 <> 0
            multi++
        end while
    end if

    return {
        single: single,
        multi: multi
    }
end function

' Splits a UTF-8 string into individual character sequences.
' Handles ASCII, accented characters, CJK and other multi-byte characters.
function utf8SplitChars(text as string) as object
    chars = []
    i = 0
    textLen = Len(text)

    while i < textLen
        byte1 = Asc(Mid(text, i + 1, 1))

        if byte1 >= 240
            sequenceLength = 4
        else if byte1 >= 224
            sequenceLength = 3
        else if byte1 >= 192
            sequenceLength = 2
        else
            sequenceLength = 1
        end if

        chars.push(Mid(text, i + 1, sequenceLength))
        i = i + sequenceLength
    end while

    return chars
end function


' Converts a UTF-8 character sequence to its Unicode code point.
function utf8CodePoint(char as string) as integer
    length = Len(char)

    b1 = Asc(Mid(char, 1, 1))

    if length = 1
        return b1
    end if

    b2 = Asc(Mid(char, 2, 1))

    if length = 2
        return (b1 and &H1F) * 64 + (b2 and &H3F)
    end if

    b3 = Asc(Mid(char, 3, 1))

    if length = 3
        return (b1 and &H0F) * 4096 + (b2 and &H3F) * 64 + (b3 and &H3F)
    end if

    b4 = Asc(Mid(char, 4, 1))

    return (b1 and &H07) * 262144 + (b2 and &H3F) * 4096 + (b3 and &H3F) * 64 + (b4 and &H3F)
end function

' Checks if a single character is covered by Ocelotl
function isCharCovered(codePoint as integer, coverage as object) as boolean
    if not isValid(coverage) or not isValid(coverage["default"]) or coverage["default"].count() = 0
        return false
    end if

    for each range in coverage["default"]
        if codePoint >= range[0] and codePoint <= range[1]
            return true
        end if
    end for

    return false
end function

' Checks if any character in text is outside Ocelotl coverage.
function textNeedsFallback(text as string, coverage as object) as boolean
    if not isValid(coverage) or not isValid(coverage["default"]) or coverage["default"].count() = 0
        return true
    end if

    for each char in utf8SplitChars(text)
        codePoint = utf8CodePoint(char)

        if not isCharCovered(codePoint, coverage)
            return true
        end if
    end for

    return false
end function

' Main function: creates font manager with Ocelotl fonts and fallback support
function createFontManager(textFontPreference as string, fontSize as integer, textColor as string, isHD as boolean, topNode as object, fallbackFonts as object) as object
    ' Select Ocelotl family based on preference
    family = getPackagedFontFamily(textFontPreference)
    ocelotlFonts = getPackagedFonts(family)

    ' Measure line heights for both font types
    ocelotlLineHeights = measureLineHeights(ocelotlFonts, fontSize, textColor, isHD, topNode)
    fallbackLineHeights = measureLineHeights(fallbackFonts, fontSize, textColor, isHD, topNode)

    ' Load coverage data from FontCoverage.bs (must be imported separately)
    coverage = getFontCoverage()

    ' Ensure coverage is valid
    if not isValid(coverage) or not isValid(coverage["default"])
        coverage = { "default": [] }
    end if

    manager = {
        ocelotlFonts: ocelotlFonts,
        fallbackFonts: fallbackFonts,
        ocelotlLineHeights: ocelotlLineHeights,
        fallbackLineHeights: fallbackLineHeights,
        coverage: coverage,
        cache: {}
    }

    return manager
end function

' Returns font data for a given text
' Returns: { fonts: {...}, lineHeights: {...}, needsFallback: boolean }
function getFontDataForText(manager as object, text as string) as object
    if manager.cache.DoesExist(text)
        return manager.cache[text]
    end if

    needsFallback = textNeedsFallback(text, manager.coverage)

    result = {
        fonts: needsFallback ? manager.fallbackFonts : manager.ocelotlFonts,
        lineHeights: needsFallback ? manager.fallbackLineHeights : manager.ocelotlLineHeights,
        needsFallback: needsFallback
    }

    manager.cache[text] = result
    return result
end function

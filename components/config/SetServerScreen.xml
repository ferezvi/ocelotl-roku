<?xml version="1.0" encoding="utf-8"?>
<component name="SetServerScreen" extends="JFScreen">
  <children>
    <LayoutGroup translation="[150,150]" itemSpacings="[40, 40, 40, 40, 15]">
      <LayoutGroup>
        <Text text="Connect to Server" id="prompt" font="font:LargeBoldSystemFont" height="65" />
      </LayoutGroup>
      <Poster id="serverPickerContainer" width="1620" height="400" uri="pkg:/images/ocelotl/ui/panels/server_panel.9.png" />
      <Text text="...or enter server URL manually:" translation="[0, 690]" />

      <Poster id="serverUrlContainer" uri="pkg:/images/ocelotl/ui/panels/server_panel.9.png">
        <TextEditBox id="serverUrlTextbox" hintText="e.g. 192.168.1.100:8096 or https://example.com/jellyfin" backgroundUri="pkg:/images/transparent.png" translation="[12,0]" />
      </Poster>

      <Text id="errorMessage" text="" font="font:MediumSystemFont" color="#ff0000FF" />

      <LayoutGroup horizAlignment="center">
        <StandardButton
          id="submit"
          text="Submit"
          height="85"
          width="250" />

        <!--add a known width invisibile element to allow the button to be centered-->
        <Rectangle id="submitSizer" width="1620" height="0" color="0x00000000" />
      </LayoutGroup>
    </LayoutGroup>

    <!-- serverPicker - positioned outside main layout for exact placement -->
    <MarkupList
      id="serverPicker"
      translation="[170, 275]"
      drawFocusFeedback="true"
      itemComponentName="JFServer"
      focusFootprintBitmapUri=""
      itemSpacing="[0, 30]"
      itemSize="[1580, 100]"
      numRows="3"
      vertFocusAnimationStyle="floatingFocus" />

  </children>
  <interface>
    <field id="forgetServer" type="string" />
    <field id="serverUrl" type="string" alias="serverUrlTextbox.text" />
    <field id="serverWidth" alias="serverUrlTextbox.width,serverUrlContainer.width,submitSizer.width" value="1620" />
    <field id="serverHeight" alias="serverUrlTextbox.height,serverUrlContainer.height" value="60" />
    <field id="errorMessage" type="string" alias="errorMessage.text" />
  </interface>
</component>
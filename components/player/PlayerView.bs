import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/MediaPlaybackState.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/enums/VideoControl.bs"
import "pkg:/source/utils/misc.bs"

const SEEK_SECONDS = 10
const SKIP_SECONDS = 30

' Phase 1: minimal playback wiring only.
'
' Everything the legacy player handles beyond this - OSD, subtitle/audio
' track switching, live TV, trickplay, chapters, retry/error recovery - is
' intentionally left out here. Each of those will come back as its own
' modular piece once basic playback is confirmed working end to end.

sub init()
    m.top.enableUI = false
    m.playerOSD = m.top.findNode("playerOSD")
    m.playerSpinner = m.top.findNode("playerSpinner")
    m.spinnerPercentLabel = m.top.findNode("spinnerPercentLabel")
    currentItem = m.global.queueManager.callFunc("getCurrentItem")
    m.top.id = currentItem.id

    m.playerOSD.observeField("action", "onOSDAction")

    preferredSubtitle = m.global.queueManager.callFunc("getPreferredSubtitleTrack")
    m.top.SelectedSubtitle = isChainValid(preferredSubtitle, "StreamIndex") ? preferredSubtitle.StreamIndex : -2

    m.loadContentTask = CreateObject("roSGNode", "LoadVideoContentTask")
    m.loadContentTask.selectedSubtitleIndex = m.top.SelectedSubtitle
    m.loadContentTask.itemId = currentItem.id
    m.loadContentTask.itemType = currentItem.type
    m.loadContentTask.selectedAudioStreamIndex = currentItem.selectedAudioStreamIndex
    m.loadContentTask.observeField("content", "onVideoContentLoaded")
    m.loadContentTask.control = TaskControl.RUN

    m.top.observeField("state", "onStateChanged")
    m.playerOSD.observeField("visible", "onOSDVisibilityChanged")

    m.progressBar = m.playerOSD.findNode("progressBar")
    m.topOSD = m.playerOSD.findNode("topOSD")
    m.playerOSD.observeField("trackSelected", "onTrackSelected")
    m.top.observeField("position", "onVideoPositionChanged")
    m.top.observeField("duration", "onVideoPositionChanged")
    m.top.observeField("bufferingStatus", "onBufferingStatusChanged")

    centerSpinnerPercentLabel()
    m.top.setFocus(true)
end sub

sub onTrackSelected()
    selection = m.playerOSD.trackSelected
    if not isValid(selection) then return

    if selection.kind = "audio"
        ' TODO: switching audio requires reloading playback with the new
        ' selectedAudioStreamIndex (see LoadVideoContentTask), preserving position
        print "[PlayerView] audio track selected: "; selection.index
    else if selection.kind = "subtitle"
        ' TODO: apply the new subtitle index to the active subtitle renderer
        print "[PlayerView] subtitle track selected: "; selection.index
    end if
end sub

sub centerSpinnerPercentLabel()
    spinnerWidth = m.playerSpinner.poster.bitmapWidth
    spinnerHeight = m.playerSpinner.poster.bitmapHeight

    m.spinnerPercentLabel.translation = [
        m.playerSpinner.translation[0] + spinnerWidth / 2 - m.spinnerPercentLabel.width / 2,
        m.playerSpinner.translation[1] + spinnerHeight / 2 - m.spinnerPercentLabel.height / 2
    ]
end sub

sub onBufferingStatusChanged()
    if m.top.state <> MediaPlaybackState.BUFFERING
        return
    end if

    if isValid(m.top.bufferingStatus)
        percentage = m.top.bufferingStatus["percentage"]

        if isValid(percentage)
            m.spinnerPercentLabel.text = percentage.ToStr() + "%"
            centerSpinnerPercentLabel()
            m.spinnerPercentLabel.visible = true
        end if
    end if
end sub

sub onVideoContentLoaded()
    m.loadContentTask.unobserveField("content")
    m.loadContentTask.control = TaskControl.STOP

    videoContent = m.loadContentTask.content
    m.loadContentTask.content = []

    if not isValid(videoContent) or not isValid(videoContent[0])
        print "[PlayerView] failed to load playback data"
        m.top.backPressed = true
        return
    end if

    item = videoContent[0]

    m.top.PlaySessionId = item.PlaySessionId
    m.top.videoId = item.id
    m.top.container = item.container
    m.top.mediaSourceId = item.mediaSourceId
    m.top.fullSubtitleData = item.fullSubtitleData
    m.top.fullAudioData = item.fullAudioData
    m.top.audioIndex = item.audioIndex
    m.top.transcodeParams = item.transcodeparams
    m.top.isTranscoded = item.isTranscoded

    m.top.content = item.content

    m.playerOSD.fullAudioData = item.fullAudioData
    m.playerOSD.fullSubtitleData = item.fullSubtitleData
    m.playerOSD.audioIndex = item.audioIndex
    m.playerOSD.selectedSubtitleIndex = item.SelectedSubtitle
    m.playerOSD.itemId = item.id

    ' TODO: Live TV will use its own OSD model instead of PlayerOSDTop
    if item.content.live
        ' return
    end if

    m.topOSD.itemTitleText = item.content.title

    if isValid(item.seasonNumber)
        m.topOSD.seasonNumber = item.seasonNumber.ToStr()
    end if

    if isValid(item.episodeNumber)
        m.topOSD.episodeNumber = item.episodeNumber.ToStr()
    end if

    if isValid(item.episodeNumberEnd)
        m.topOSD.episodeNumberEnd = item.episodeNumberEnd.ToStr()
    end if

    m.topOSD.logoImage = isValidAndNotEmpty(item.logoImage) ? item.logoImage : ""
    m.top.control = VideoControl.PLAY
    m.top.setFocus(true)
end sub

sub onStateChanged()
    print "[PlayerView] state: "; m.top.state
    m.playerOSD.playbackState = m.top.state

    if m.top.state = MediaPlaybackState.BUFFERING
        m.playerSpinner.visible = true
        m.spinnerPercentLabel.visible = true
    else
        m.playerSpinner.visible = false
        m.spinnerPercentLabel.visible = false
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    print "[PlayerOSD] onKeyEvent key="; key; " press="; press
    if not press then return false

    if m.playerOSD.visible
        return false
    end if

    if isStringEqual(key, KeyCode.OK)
        if isStringEqual(m.top.state, MediaPlaybackState.PLAYING)
            m.top.control = VideoControl.PAUSE
        end if
        m.playerOSD.visible = true
        m.playerOSD.callFunc("focusControls")
        return true
    else if isStringEqual(key, KeyCode.UP)
        m.playerOSD.visible = true
        m.playerOSD.callFunc("focusOptionControls")
        return true
    else if isStringEqual(key, KeyCode.DOWN)
        m.playerOSD.visible = true
        m.playerOSD.callFunc("focusControls")
        return true
    else if isStringEqual(key, KeyCode.RIGHT) or isStringEqual(key, KeyCode.LEFT) or isStringEqual(key, KeyCode.FASTFORWRD) or isStringEqual(key, KeyCode.REWIND)
        m.playerOSD.visible = true
        m.playerOSD.callFunc("focusProgressBar")
        direction = (isStringEqual(key, KeyCode.RIGHT) or isStringEqual(key, KeyCode.FASTFORWRD)) ? 1 : -1
        m.progressBar.callFunc("seekStep", direction)
        return true
    else if isStringEqual(key, KeyCode.BACK)
        m.top.control = VideoControl.STOP
        m.global.sceneManager.callFunc("popScene")
        return true
    end if

    return false
end function

sub onOSDAction(event as object)
    action = event.getData()

    if action = "playPauseButton"
        if isStringEqual(m.top.state, MediaPlaybackState.PLAYING)
            m.top.control = VideoControl.PAUSE
        else
            m.top.control = VideoControl.RESUME
        end if
    else if action = "rewindButton"
        m.top.seek = max(0, m.top.position - SEEK_SECONDS)
    else if action = "fastForwardButton"
        m.top.seek = m.top.position + SEEK_SECONDS
    else if action = "skipBackButton"
        m.top.seek = max(0, m.top.position - SKIP_SECONDS)
    else if action = "skipForwardButton"
        m.top.seek = m.top.position + SKIP_SECONDS
    else if action = "seek"
        if m.playerOSD.seekPosition <> invalid
            m.top.seek = m.playerOSD.seekPosition
        end if
    else if action = "seekStart"
        m.top.control = VideoControl.PAUSE
    else if action = "seekEnd"
        m.top.control = VideoControl.RESUME
    else if action = "hide"
        hideOSD()
    end if
end sub

function max(a as float, b as float) as float
    if a > b then return a
    return b
end function

sub onVideoPositionChanged()
    progressBar = m.playerOSD.findNode("progressBar")
    if progressBar <> invalid and m.top.position <> invalid and m.top.duration <> invalid
        progressBar.position = m.top.position
        progressBar.duration = m.top.duration
    end if
end sub

sub onOSDVisibilityChanged()
    if not m.playerOSD.visible
        m.top.setFocus(true)
    end if
end sub

sub hideOSD()
    m.playerOSD.setFocus(false)
    m.top.setFocus(true)
    m.playerOSD.visible = false
end sub

import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/SubtitleSelection.bs"
import "pkg:/source/utils/misc.bs"

const OSD_INACTIVITY_TIMEOUT_SECONDS = 5

sub init()
    m.videoControls = m.top.findNode("videoControls")
    m.progressBar = m.top.findNode("progressBar")
    m.optionControls = m.top.findNode("optionControls")
    m.languagePanel = m.top.findNode("languagePanel")

    m.videoControls.observeField("action", "onVideoControlsAction")
    m.optionControls.observeField("action", "onOptionControlsAction")

    m.progressBar.observeField("seek", "onProgressBarSeek")
    m.progressBar.observeField("isSeeking", "onProgressBarSeekingChanged")
    m.top.observeField("visible", "onVisibleChanged")
    m.top.observeField("playbackState", "onIsPlayingChanged")

    m.videoControls.observeField("keyPressed", "onKeyPressed")
    m.progressBar.observeField("keyPressed", "onKeyPressed")
    m.optionControls.observeField("keyPressed", "onKeyPressed")
    m.languagePanel.observeField("keyPressed", "onKeyPressed")

    m.languagePanel.observeField("visible", "onLanguagePanelVisibleChanged")
    m.languagePanel.observeField("selectionMade", "onLanguagePanelSelection")

    m.mediaInfoPanel = m.top.findNode("mediaInfoPanel")
    m.mediaInfoPanel.observeField("keyPressed", "onKeyPressed")
    m.mediaInfoPanel.observeField("visible", "onMediaInfoPanelVisibleChanged")

    m.mediaInfoTask = createObject("roSGNode", "GetPlaybackInfoTask")
    m.mediaInfoTask.observeField("data", "onPlaybackInfoLoaded")
    m.top.appendChild(m.mediaInfoTask)

    m.inactivityTimer = CreateObject("roSGNode", "Timer")
    m.inactivityTimer.duration = OSD_INACTIVITY_TIMEOUT_SECONDS
    m.inactivityTimer.observeField("fire", "onInactivityTimerFire")
    m.top.appendChild(m.inactivityTimer)
end sub

' Restarts the OSD when it becomes visible (regardless of what triggered
' the show) and stops it once the OSD is hidden, so it doesn't fire a
' stray "hide" action while already hidden.
sub onVisibleChanged()
    if m.top.visible
        resetInactivityTimer()
    else
        m.inactivityTimer.control = "stop"
    end if
end sub

sub resetInactivityTimer()
    m.inactivityTimer.control = "stop"
    m.inactivityTimer.control = "start"
end sub

sub onInactivityTimerFire()
    if m.languagePanel.visible
        m.languagePanel.visible = false
    end if

    if m.mediaInfoPanel.visible
        m.mediaInfoPanel.visible = false
    end if

    if m.top.visible
        m.top.action = "hide"
    end if
end sub

sub onKeyPressed()
    resetInactivityTimer()
end sub

sub onProgressBarSeekingChanged()
    m.top.action = m.progressBar.isSeeking ? "seekStart" : "seekEnd"

    if m.progressBar.isSeeking
        m.inactivityTimer.control = "stop"
    else
        resetInactivityTimer()
    end if
end sub

sub onVideoControlsAction(event as object)
    m.top.action = event.getData()
end sub

sub onOptionControlsAction(event as object)
    action = event.getData()
    if action = "languageButton"
        ' En lugar de abrir LanguagePanel, usa el diálogo legacy
        openLegacyAudioDialog()
    end if
end sub

sub openLegacyAudioDialog()
    ' Construir audioData igual que ViewCreator
    audioData = { data: [] }
    preferredAudioTrackName = m.global.queueManager.callFunc("getPreferredAudioTrackName")

    for each stream in m.top.fullAudioData
        item = {
            "Index": stream.Index,
            "RokuTrackName": stream.RokuTrackName,
            "IsExternal": stream.IsExternal,
            "Track": { "description": stream.DisplayTitle },
            "Type": "audioselection"
        }
        if isStringEqual(stream.RokuTrackName, preferredAudioTrackName)
            item.selected = true
        end if
        audioData.data.push(item)
    end for

    ' Llamar al diálogo legacy
    m.global.sceneManager.callFunc("radioDialog", tr("Select Audio"), audioData)
    m.global.sceneManager.observeField("returnData", "onLegacyAudioSelected")
end sub

' onLegacyAudioSelected: Procesa la selección del diálogo legacy y la reenvía
' por el mismo camino que ya usa el LanguagePanel (m.top.trackSelected ->
' PlayerView.onTrackSelected -> switchAudioTrack).
'
' IMPORTANTE: m.top.audioIndex en PlayerView.bs vive en la escala nativa
' de Roku (el "Track" de availableAudioTracks), NO en la escala de Jellyfin
' (el "Index" de fullAudioData/selection). switchAudioTrack compara
' desiredIndex contra m.top.audioIndex directamente, asi que hay que
' convertir selection.RokuTrackName -> Track de Roku antes de emitirlo,
' o si no la comparacion "desiredIndex = m.top.audioIndex" puede coincidir
' por casualidad numerica entre dos escalas distintas y no hacer nada.
sub onLegacyAudioSelected()
    m.global.sceneManager.unobserveField("returnData")
    selection = m.global.sceneManager.returnData
    if not isValid(selection) or selection.Type <> "audioselection" then return

    m.global.queueManager.callFunc("setPreferredAudioTrackName", selection.RokuTrackName)

    playerView = m.top.getParent()
    resolvedIndex = selection.Index ' fallback si no hay match (misma logica legacy)

    if isValid(playerView) and isValid(playerView.availableAudioTracks)
        for each audioTrack in playerView.availableAudioTracks
            if isStringEqual(audioTrack.LookupCI("name"), selection.RokuTrackName)
                resolvedIndex = audioTrack.LookupCI("Track").toint()
                exit for
            end if
        end for
    end if

    m.top.trackSelected = {
        kind: "audio",
        index: resolvedIndex
    }
end sub




sub openMediaInfoPanel()
    m.mediaInfoPanel.lines = [{ text: tr("Loading..."), isHeader: false }]
    m.mediaInfoPanel.visible = true
    resetInactivityTimer()

    m.mediaInfoTask.videoID = m.top.itemId
    m.mediaInfoTask.control = "RUN"
end sub

sub onPlaybackInfoLoaded()
    data = m.mediaInfoTask.data
    if not isValid(data) or not isValid(data.playbackInfo) then return

    m.mediaInfoPanel.lines = parsePlaybackInfoLines(data.playbackInfo.data)
end sub

' Adapter: strips the <header>/<b> markup GetPlaybackInfoTask builds for the
' legacy standardDialog, since our Label-based MediaInfoPanel can't render HTML
function parsePlaybackInfoLines(rawLines as object) as object
    lines = []

    if not isValidAndNotEmpty(rawLines) then return lines

    for each raw in rawLines
        text = raw
        isHeader = Instr(1, text, "<header>") > 0

        text = text.Replace("<header>", "")
        text = text.Replace("</header>", "")
        text = text.Replace("<b>", "")
        text = text.Replace("</b>", "")

        lines.push({ text: text, isHeader: isHeader })
    end for

    return lines
end function

sub onMediaInfoPanelVisibleChanged()
    if not m.mediaInfoPanel.visible
        m.optionControls.callFunc("focusControls")
    end if
end sub

sub openLanguagePanel()
    print "[PlayerOSD] openLanguagePanel called"
    print "[PlayerOSD] fullAudioData count: "; m.top.fullAudioData.count()
    m.languagePanel.audioContent = buildAudioContent(m.top.fullAudioData, m.top.audioIndex)
    m.languagePanel.subtitleContent = buildSubtitleContent(m.top.fullSubtitleData, m.top.selectedSubtitleIndex)
    m.languagePanel.visible = true
    resetInactivityTimer()
end sub

' ============================================================
' MODIFICADO: AÑADIR trackName
' ============================================================
function buildAudioContent(streams as object, selectedIndex as integer) as object
    print "[PlayerOSD] buildAudioContent called, streams count: "; streams.count()
    result = []
    if not isValidAndNotEmpty(streams) then return result

    for each stream in streams
        label = isValidAndNotEmpty(stream.Title) ? stream.Title : stream.DisplayTitle
        if not isValidAndNotEmpty(label) then label = stream.Language

        result.push({
            kind: "audio",
            index: stream.Index,
            selected: (stream.Index = selectedIndex),
            track: { description: label },
            trackName: stream.RokuTrackName ' <--- NUEVO
        })
    end for

    return result
end function

' Adapter: raw Jellyfin subtitle streams -> same shape, plus a synthetic
' "Off" entry at the top since the server never sends one
function buildSubtitleContent(subtitles as object, selectedIndex as integer) as object
    result = [{
        kind: "subtitle",
        index: SubtitleSelection.NONE,
        selected: (selectedIndex = SubtitleSelection.NONE),
        track: { description: tr("Off") }
    }]

    if isValidAndNotEmpty(subtitles)
        for each subtitle in subtitles
            result.push({
                kind: "subtitle",
                index: subtitle.Index,
                selected: (subtitle.Index = selectedIndex),
                track: { description: subtitle.Track.Description }
            })
        end for
    end if

    return result
end function

' ============================================================
' MODIFICADO: PROCESAR SELECCIÓN Y ACTUALIZAR REPRODUCTOR
' ============================================================
sub onLanguagePanelSelection()
    selection = m.languagePanel.selectionMade
    print "[PlayerOSD] onLanguagePanelSelection received: "; selection
    if not isValid(selection) then return

    ' Emitir la selección hacia PlayerView
    m.top.trackSelected = selection
    print "[PlayerOSD] trackSelected emitted to PlayerView" ' El panel permanece abierto
end sub

sub onLanguagePanelVisibleChanged()
    if not m.languagePanel.visible
        m.optionControls.callFunc("focusControls")
    end if
end sub

sub onProgressBarSeek()
    m.top.seekPosition = m.progressBar.seek
    m.top.action = "seek"
end sub

sub onIsPlayingChanged()
    m.videoControls.playbackState = m.top.playbackState
end sub

sub focusControls()
    m.optionControls.callFunc("clearFocus")
    m.videoControls.callFunc("focusControls")
end sub

sub focusProgressBar()
    m.videoControls.callFunc("clearFocus")
    m.optionControls.callFunc("clearFocus")
    m.progressBar.setFocus(true)
end sub

sub focusOptionControls()
    m.videoControls.callFunc("clearFocus")
    m.optionControls.callFunc("focusControls")
end sub

' UP/DOWN switches focus between progress bar and controls, BACK closes the OSD
' (unless the progress bar is mid-seek, in which case it cancels the seek first)
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if isStringEqual(key, KeyCode.BACK) and m.progressBar.hasFocus() and m.progressBar.isSeeking
        return false ' let progress bar cancel its own seek first
    end if

    if isStringEqual(key, KeyCode.UP)
        if m.videoControls.isInFocusChain()
            m.videoControls.callFunc("clearFocus")
            m.progressBar.setFocus(true)
            return true

        else if m.progressBar.hasFocus()
            m.progressBar.setFocus(false)
            m.optionControls.callFunc("focusControls")
            return true
        end if

    else if isStringEqual(key, KeyCode.DOWN)
        if m.optionControls.isInFocusChain()
            m.optionControls.callFunc("clearFocus")
            m.progressBar.setFocus(true)
            return true

        else if m.progressBar.hasFocus()
            m.progressBar.setFocus(false)
            m.videoControls.callFunc("focusControls")
            return true
        end if

    else if isStringEqual(key, KeyCode.LEFT) and (m.videoControls.isInFocusChain() or m.optionControls.isInFocusChain())
        return true ' edge of the row - no horizontal handoff between rows anymore

    else if isStringEqual(key, KeyCode.RIGHT) and (m.videoControls.isInFocusChain() or m.optionControls.isInFocusChain())
        return true ' edge of the row - no horizontal handoff between rows anymore

    else if isStringEqual(key, KeyCode.BACK)
        m.top.action = "hide"
        return true
    end if

    return false
end function

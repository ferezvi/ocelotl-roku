import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.videoControls = m.top.findNode("videoControls")
    m.progressBar = m.top.findNode("progressBar")

    m.videoControls.observeField("action", "onVideoControlsAction")
    m.progressBar.observeField("seek", "onProgressBarSeek")
    m.progressBar.observeField("isSeeking", "onProgressBarSeekingChanged")
end sub

sub onProgressBarSeekingChanged()
    m.top.action = m.progressBar.isSeeking ? "seekStart" : "seekEnd"
end sub

sub onVideoControlsAction(event as object)
    m.top.action = event.getData()
end sub

sub onProgressBarSeek()
    m.top.seekPosition = m.progressBar.seek
    m.top.action = "seek"
end sub

sub onIsPlayingChanged()
    m.videoControls.playbackState = m.top.playbackState
end sub

sub focusControls()
    m.videoControls.callFunc("focusControls")
end sub

sub focusProgressBar()
    m.progressBar.setFocus(true)
end sub

' UP/DOWN switches focus between progress bar and controls, BACK closes the OSD
' (unless the progress bar is mid-seek, in which case it cancels the seek first)
function onKeyEvent(key as string, press as boolean) as boolean
    print "[PlayerOSD] onKeyEvent key="; key; " press="; press

    if not press then return false

    if isStringEqual(key, KeyCode.BACK) and m.progressBar.hasFocus() and m.progressBar.isSeeking
        return false ' let progress bar cancel its own seek first
    end if

    if isStringEqual(key, KeyCode.UP)
        m.progressBar.setFocus(true)
        return true

    else if isStringEqual(key, KeyCode.DOWN)
        if m.progressBar.hasFocus()
            m.videoControls.callFunc("focusControls")
            return true
        end if

    else if isStringEqual(key, KeyCode.BACK)
        m.top.action = "hide"
        return true
    end if

    return false
end function

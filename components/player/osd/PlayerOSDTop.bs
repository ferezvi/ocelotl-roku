import "pkg:/source/utils/misc.bs"

const LOGO_RIGHT_PADDING = 30

sub init()
    m.videoInfo = m.top.findNode("videoInfo")
    m.itemTitle = m.top.findNode("itemTitle")
    m.itemSeason = m.top.findNode("itemSeason")
    m.itemEpisode = m.top.findNode("itemEpisode")
    m.itemEpisodeEnd = m.top.findNode("itemEpisodeEnd")
    m.logoImage = m.top.findNode("logoImage")

    m.top.observeField("itemTitleText", "onItemTitleChanged")
    m.top.observeField("itemSubtitleText", "onSubtitleChanged")
    m.top.observeField("seasonNumber", "onSeasonChanged")
    m.top.observeField("episodeNumber", "onEpisodeChanged")
    m.top.observeField("episodeNumberEnd", "onEpisodeEndChanged")
    m.top.observeField("logoImage", "onLogoChanged")
end sub

sub onItemTitleChanged()
    m.itemTitle.text = m.top.itemTitleText
end sub

sub onSubtitleChanged()
    if isValidAndNotEmpty(m.top.itemSubtitleText)
        m.itemSeason.text = m.top.itemSubtitleText
    end if
end sub

sub onSeasonChanged()
    if isValidAndNotEmpty(m.top.seasonNumber)
        m.itemSeason.text = `S${m.top.seasonNumber}`
    end if
end sub

sub onEpisodeChanged()
    if isValidAndNotEmpty(m.top.episodeNumber)
        m.itemEpisode.text = `E${m.top.episodeNumber}`
    end if
end sub

sub onEpisodeEndChanged()
    if isValidAndNotEmpty(m.top.episodeNumberEnd)
        m.itemEpisodeEnd.text = `-${m.top.episodeNumberEnd}`
    end if
end sub

sub onLogoChanged()
    if not isValidAndNotEmpty(m.top.logoImage)
        m.logoImage.visible = false
        return
    end if

    m.logoImage.uri = m.top.logoImage
    m.logoImage.visible = true
    m.logoImage.observeField("loadStatus", "onLogoLoadStatusChanged")
end sub

sub onLogoLoadStatusChanged(event)
    if event.getData() <> "ready"
        return
    end if

    logoWidth = m.logoImage.bitmapWidth

    m.videoInfo.translation = [
        103 + logoWidth + LOGO_RIGHT_PADDING,
        61
    ]

    m.itemTitle.maxWidth = 1400 - logoWidth - LOGO_RIGHT_PADDING
end sub

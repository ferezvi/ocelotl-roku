<?xml version="1.0" encoding="utf-8"?>
<component name="LanguagePanel" extends="Group">
    <interface>
        <field id="audioContent" type="array" />
        <field id="subtitleContent" type="array" />
        <field id="selectionMade" type="assocarray" alwaysNotify="true" />
        <field id="keyPressed" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <timer id="selectionTimer" duration="0.01" />
        <Poster
            id="background"
            uri="pkg:/images/player/language_panel.png"
            width="1280"
            height="1080" />
        <LayoutGroup id="columnsContainer" layoutDirection="horiz" itemSpacings="[20]" translation="[20,290]">
            <LayoutGroup id="audioColumn" layoutDirection="vert" itemSpacings="[18]">
                <Text id="audioHeader" text="Audio" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
                <ButtonGroup id="audioButtons" layoutDirection="vert" itemSpacings="[4]" />
            </LayoutGroup>
            <LayoutGroup id="subtitleColumn" layoutDirection="vert" itemSpacings="[18]">
                <Text id="subtitleHeader" text="Subtitles" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />
                <ButtonGroup id="subtitleButtons" layoutDirection="vert" itemSpacings="[4]" />
            </LayoutGroup>
        </LayoutGroup>
    </children>
</component>
<?xml version="1.0" encoding="utf-8"?>
<component name="TrackHandler" extends="Group">

    <interface>
        <!-- ========================================================
             AUDIO
             ======================================================== -->

        <field id="availableAudioTracks" type="array" />
        <field id="currentAudioTrack" type="string" />
        <field id="preferredAudioTrackName" type="string" />
        <field id="audioIndex" type="integer" value="-1" />
        <field id="audioReloadIndex" type="integer" value="-1" alwaysNotify="true" />

        <!-- ========================================================
             SUBTITLES
             ======================================================== -->

        <field id="fullSubtitleData" type="array" />
        <field id="availableSubtitleTracks" type="array" />

        <field id="selectedSubtitleIndex" type="integer" value="-2" />

        <field id="previousSubtitleWasEncoded" type="boolean" value="false" />

        <field id="globalCaptionMode" type="string" />
        <field id="subtitleTrack" type="string" />

        <field id="subtitleReloadIndex" type="integer" value="-2" alwaysNotify="true" />

        <!-- ========================================================
             PLAYER OSD SELECTION
             ======================================================== -->

        <field id="trackSelected" type="assocarray" alwaysNotify="true" />
    </interface>

</component>
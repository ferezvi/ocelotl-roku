import "pkg:/source/enums/MediaPlaybackState.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/misc.bs"

' Plain BrightScript module, not a SceneGraph component. Imported directly
' into VideoPlayer.bs, so its functions run in VideoPlayer's own `m` scope -
' m.top, m.global, m.playbackTimer etc. all refer to the same things they
' would if this code still lived in VideoPlayer.bs itself.

' Sets up the periodic playback-reporting timer. Call once from VideoPlayer's
' init().
sub initPlaybackReporter()
    m.playbackTimer = m.top.findNode("playbackTimer")
    m.playbackTimer.observeField("fire", "ReportPlayback")
    m.playReported = false
end sub

' Called from onStateChanged() whenever m.top.state changes. Decides when to
' report playback start/update/stop and drives the periodic report timer.
sub reportPlaybackStateChanged()
    if isStringEqual(m.top.state, MediaPlaybackState.PLAYING)
        if not m.playReported
            ReportPlayback("start")
            m.playReported = true
        else
            ReportPlayback()
        end if

        m.playbackTimer.control = "start"

    else if isStringEqual(m.top.state, MediaPlaybackState.PAUSED)
        m.playbackTimer.control = "stop"
        ReportPlayback()

    else if isStringEqual(m.top.state, MediaPlaybackState.STOPPED)
        m.playbackTimer.control = "stop"

        if m.playReported
            ReportPlayback("stop")
            m.playReported = false
        end if

    else if isStringEqual(m.top.state, MediaPlaybackState.FINISHED)
        m.playbackTimer.control = "stop"
        ReportPlayback("stop")
        m.playReported = false
    end if
end sub

' Also bound directly as the playbackTimer's "fire" observer (see
' initPlaybackReporter) - hence the exported, capitalized name matching
' the original, so no observeField wiring needs to change.
sub ReportPlayback(state = "update" as string)
    if m.top.position = invalid
        return
    end if

    params = {
        "ItemId": m.top.id,
        "PlaySessionId": m.top.PlaySessionId,
        "PositionTicks": int(m.top.position) * 10000000&,
        "IsPaused": isStringEqual(m.top.state, MediaPlaybackState.PAUSED)
    }

    ' Live TV isn't implemented yet in Ocelotl - this branch is inert
    ' today but keeps parity with upstream for when it lands.
    if isValid(m.top.content) and isValid(m.top.content.live) and m.top.content.live
        params.append({
            "MediaSourceId": m.top.transcodeParams.MediaSourceId,
            "LiveStreamId": m.top.transcodeParams.LiveStreamId
        })
        m.bufferCheckTimer.duration = 30
    end if

    if inArray(["stop", "finished"], state) and isValid(m.originalClosedCaptionState)
        m.top.globalCaptionMode = m.originalClosedCaptionState
        m.originalClosedCaptionState = invalid
    end if

    playstateTask = m.global.playstateTask

    if not isValid(playstateTask)
        return
    end if

    playstateTask.setFields({
        status: state,
        params: params
    })

    playstateTask.control = TaskControl.RUN
end sub

' captionWrap.bs
' Contains all caption text wrapping and balancing functions extracted from captionTask

' Maximum width allowed before caption text wraps to the next line
const SAFE_TEXT_WIDTH = Int(1920 * 0.75)

' Maximum number of visual lines a caption may be balanced across.
const MAX_BALANCED_LINES = 3

' Cache for measured text widths to avoid redundant measureCaptionWidth calls
' Structure: { "text": width }
' Note: This is a simple cache; could be enhanced with LRU if needed
function getCachedWidth(text as string) as integer
    if m.widthCache = invalid
        m.widthCache = {}
    end if

    if m.widthCache.DoesExist(text)
        return m.widthCache[text]
    end if

    m.measureLabel.text = text
    width = m.measureLabel.boundingRect().width
    m.widthCache[text] = width
    return width
end function

' Wraps caption text so no visual line exceeds maxWidth pixels while
' preserving inline style tags across inserted line breaks.
' Balances per original line so wrapping never merges separate VTT lines
' (e.g. dialogue turns) together.
function wrapLongLines(text as string, maxWidth as integer) as string
    lines = text.split(Chr(10))
    wrapped = []
    for each line in lines
        singleWrapped = wrapSingleLine(line, maxWidth)
        wrapped.push(balanceCaptionLines(singleWrapped, maxWidth))
    end for
    return wrapped.join(Chr(10))
end function

' Balances wrapped caption lines by redistributing words across up to
' MAX_BALANCED_LINES lines. Originally this only balanced when exactly 2
' lines were produced; that missed cases where 2 lines were both close to
' maxWidth and a 3-line split would read better. This version searches for
' the minimum line count that fits, then balances within that count.
function balanceCaptionLines(text as string, maxWidth as integer) as string
    lines = text.split(Chr(10))

    ' Nothing to balance for single-line captions
    if lines.count() < 2
        return text
    end if

    ' Build words array and pre-calculate individual word widths
    words = []
    wordWidths = []
    for each line in lines
        for each word in line.split(" ")
            if word.Len() > 0
                words.push(word)
                wordWidths.push(getCachedWidth(word))
            end if
        end for
    end for

    if words.count() < 3
        return text
    end if

    spaceWidth = getCachedWidth(" ")

    ' Pre-calculate segment widths for all possible slices
    ' segmentWidths[i][j] = width of words from i to j (exclusive)
    segmentWidths = []
    for i = 0 to words.count() - 1
        row = []
        currentWidth = 0
        for j = i to words.count() - 1
            if j > i
                currentWidth += spaceWidth
            end if
            currentWidth += wordWidths[j]
            row.push(currentWidth)
        end for
        segmentWidths.push(row)
    end for

    ' Pre-calculate segment texts for all possible slices
    ' segmentTexts[i][j] = text of words from i to j (exclusive)
    segmentTexts = []
    for i = 0 to words.count() - 1
        row = []
        currentText = ""
        for j = i to words.count() - 1
            if j > i
                currentText += " "
            end if
            currentText += words[j]
            row.push(currentText)
        end for
        segmentTexts.push(row)
    end for

    ' Determine minimum line count (2 or 3) that fits
    targetLineCount = 0
    for candidateCount = 2 to MAX_BALANCED_LINES
        if candidateCount >= words.count()
            exit for
        end if
        if canFitInLinesOptimized(words, wordWidths, candidateCount, maxWidth, spaceWidth)
            targetLineCount = candidateCount
            exit for
        end if
    end for

    ' No arrangement fits within MAX_BALANCED_LINES; keep the original wrap.
    if targetLineCount = 0
        return text
    end if

    bestSplit = findBestSplitOptimized(words, targetLineCount, maxWidth, segmentWidths, segmentTexts)
    if bestSplit = invalid
        return text
    end if

    return bestSplit.join(Chr(10))
end function

' Checks whether words can be greedily wrapped into lineCount lines (or fewer)
' without exceeding maxWidth on any line.
' Uses pre-calculated word widths to avoid redundant measurements.
function canFitInLinesOptimized(words as object, wordWidths as object, lineCount as integer, maxWidth as integer, spaceWidth as integer) as boolean
    linesUsed = 1
    currentWidth = 0

    for i = 0 to words.count() - 1
        wordW = wordWidths[i]

        ' Calculate width if we add this word to current line
        newWidth = currentWidth
        if currentWidth > 0
            newWidth += spaceWidth
        end if
        newWidth += wordW

        if newWidth > maxWidth and currentWidth > 0
            ' Word doesn't fit, start new line
            linesUsed++
            if linesUsed > lineCount then return false
            currentWidth = wordW
            if wordW > maxWidth then return false
        else
            currentWidth = newWidth
        end if
    end for

    return true
end function

' Finds the split of words into exactly lineCount lines that minimizes the
' gap between the widest and narrowest line, keeping every line under
' maxWidth. Brute-forced over split points; cheap given typical caption
' word counts.
' Uses pre-calculated segment widths for efficiency.
function findBestSplitOptimized(words as object, lineCount as integer, maxWidth as integer, segmentWidths as object, segmentTexts as object) as object
    splitCombinations = generateSplitCombinations(words.count(), lineCount, segmentWidths, maxWidth)

    bestLines = invalid
    bestScore = invalid

    for each split in splitCombinations
        candidateLines = []
        widths = []
        start = 0
        valid = true

        for each cut in split
            ' Use pre-calculated segment width instead of measuring
            segmentWidth = segmentWidths[start][cut - start - 1]
            if segmentWidth > maxWidth
                valid = false
                exit for
            end if

            segment = segmentTexts[start][cut - start - 1]
            candidateLines.push(segment)
            widths.push(segmentWidth)
            start = cut
        end for

        if not valid then continue for

        maxW = widths[0]
        minW = widths[0]
        for each w in widths
            if w > maxW then maxW = w
            if w < minW then minW = w
        end for
        score = maxW - minW

        if bestScore = invalid or score < bestScore
            bestScore = score
            bestLines = candidateLines
        end if
    end for

    return bestLines
end function

' Generates every way to place (lineCount - 1) internal cut points across
' wordCount words. E.g. 3 lines / 5 words -> [[1,2,5],[1,3,5],[1,4,5],[2,3,5]...]
' Now with pruning: only generates combinations where all segments fit in maxWidth
function generateSplitCombinations(wordCount as integer, lineCount as integer, segmentWidths as object, maxWidth as integer) as object
    cutsNeeded = lineCount - 1
    combinations = []

    if cutsNeeded = 1
        for i = 1 to wordCount - 1
            ' Prune: first segment must fit, last segment must fit
            if segmentWidths[0][i - 1] <= maxWidth and segmentWidths[i][wordCount - i - 1] <= maxWidth
                combinations.push([i, wordCount])
            end if
        end for
    else if cutsNeeded = 2
        for i = 1 to wordCount - 2
            for j = i + 1 to wordCount - 1
                ' Prune: all three segments must fit
                if segmentWidths[0][i - 1] <= maxWidth and segmentWidths[i][j - i - 1] <= maxWidth and segmentWidths[j][wordCount - j - 1] <= maxWidth
                    combinations.push([i, j, wordCount])
                end if
            end for
        end for
    end if

    return combinations
end function

function wrapSingleLine(line as string, maxWidth as integer) as string
    ' Tokenize vs. plain text - single pass
    tokens = []
    position = 0
    lineLen = line.Len()
    while position < lineLen
        if line.Mid(position, 1) = "<"
            tagEnd = line.Instr(position, ">")
            if tagEnd = -1
                tokens.push({ type: "text", value: line.Mid(position) })
                position = lineLen
            else
                tokens.push({ type: "tag", value: line.Mid(position, tagEnd - position + 1) })
                position = tagEnd + 1
            end if
        else
            nextTag = line.Instr(position, "<")
            if nextTag = -1
                tokens.push({ type: "text", value: line.Mid(position) })
                position = lineLen
            else
                tokens.push({ type: "text", value: line.Mid(position, nextTag - position) })
                position = nextTag
            end if
        end if
    end while

    ' Expand plain-text tokens into words/spaces so we can break between them
    expanded = []
    for each token in tokens
        if token.type = "tag"
            expanded.push(token)
        else
            words = token.value.split(" ")
            for i = 0 to words.count() - 1
                if words[i].Len() > 0
                    expanded.push({ type: "word", value: words[i] })
                end if
                if i < words.count() - 1
                    expanded.push({ type: "space" })
                end if
            end for
        end if
    end for

    openTags = []
    outputParts = [] ' Use array instead of string concatenation
    currentPlainText = ""
    currentPlainWidth = 0
    spaceWidth = getCachedWidth(" ")

    for each token in expanded
        if token.type = "tag"
            outputParts.push(token.value)
            if token.value.StartsWith("</")
                if openTags.count() > 0 then openTags.pop()
            else
                openTags.push(token.value)
            end if
        else if token.type = "space"
            outputParts.push(" ")
            currentPlainText += " "
            currentPlainWidth += spaceWidth
        else
            ' token.type = "word"
            wordWidth = getCachedWidth(token.value)

            ' Calculate total width if we add this word
            candidateWidth = currentPlainWidth
            if currentPlainWidth > 0
                candidateWidth += spaceWidth
            end if
            candidateWidth += wordWidth

            if candidateWidth > maxWidth and currentPlainText.Len() > 0
                ' Need to break - close tags, add newline, reopen tags
                for i = openTags.count() - 1 to 0 step -1
                    tagName = openTags[i].Mid(1, openTags[i].Len() - 2)
                    spacePos = tagName.Instr(0, " ")
                    if spacePos <> -1 then tagName = tagName.Left(spacePos)
                    outputParts.push(`</${tagName}>`)
                end for
                outputParts.push(Chr(10))
                for each tag in openTags
                    outputParts.push(tag)
                end for

                ' Reset current line with this word
                currentPlainText = token.value
                currentPlainWidth = wordWidth
                outputParts.push(token.value)
            else
                ' Word fits, add it
                if currentPlainText.Len() > 0
                    outputParts.push(" ")
                    currentPlainText += " "
                    currentPlainWidth += spaceWidth
                end if
                outputParts.push(token.value)
                currentPlainText += token.value
                currentPlainWidth += wordWidth
            end if
        end if
    end for

    return outputParts.join("")
end function

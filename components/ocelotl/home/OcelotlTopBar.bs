import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/PosterLoadStatus.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.clockLabel = m.top.findNode("clock")

    m.searchIcon = m.top.findNode("searchIcon")

    m.avatarMask = m.top.findNode("avatarMask")
    m.avatarImage = m.top.findNode("avatarImage")

    m.avatarFocusRing = m.top.findNode("avatarFocusRing")

    ' Adjust MaskGroup size for HD devices because maskSize does not currently
    ' follow SceneGraph automatic resolution scaling. Asset is 66x66 (not 64x64)
    ' because it must be divisible by 3 for clean 2/3 scaling to HD (66 -> 44).
    if isValid(m.avatarMask)
        ' Adjust MaskGroup size for HD devices because maskSize does not currently
        ' follow SceneGraph automatic resolution scaling. Asset is 66x66 (not 64x64)
        ' because it must be divisible by 3 for clean 2/3 scaling to HD (66 -> 44).
        size = scaleMaskSize(66)
        m.avatarMask.maskSize = [size, size]
    end if


    loadAvatarImage()

    updateHighlight()

    m.clockTimer = m.top.findNode("clockTimer")
    m.clockTimer.observeField("fire", "updateClock")
    updateClock()

    m.top.observeField("focusedChild", "onFocusChanged")
end sub

' Loads the current session user's profile image, falling back to the
' generic person icon on failure (same pattern as JFOverhang.bs)
sub loadAvatarImage()
    userId = chainLookupReturn(m.global, "session.user.id", invalid)
    if isValid(userId)
        m.avatarImage.observeField("loadStatus", "onAvatarLoadStatusChanged")
        m.avatarImage.uri = UserImageURL(userId)
    end if
end sub

sub onAvatarLoadStatusChanged()
    if m.avatarImage.loadStatus <> PosterLoadStatus.LOADING
        m.avatarImage.unobserveField("loadStatus")
    end if

    if m.avatarImage.loadStatus = PosterLoadStatus.FAILED
        m.avatarImage.uri = "pkg:/images/baseline_person_white_48dp.png"
    end if
end sub

sub onFocusChanged()
    updateHighlight()
end sub

sub updateClock()
    dt = CreateObject("roDateTime")
    dt.ToLocalTime()

    hour24 = dt.GetHours()
    minutes = dt.GetMinutes()

    suffix = "am"
    hour12 = hour24
    if hour24 = 0
        hour12 = 12
    else if hour24 = 12
        suffix = "pm"
    else if hour24 > 12
        hour12 = hour24 - 12
        suffix = "pm"
    end if

    minutesStr = minutes.ToStr()
    if minutes < 10 then minutesStr = "0" + minutesStr

    m.clockLabel.text = hour12.ToStr() + ":" + minutesStr + " " + suffix
end sub

sub updateHighlight()
    if not m.top.isInFocusChain()
        m.searchIcon.blendColor = ColorPalette.TEXT_SECONDARY
        m.avatarFocusRing.visible = false
        return
    end if

    if m.top.focusedIndex = 0
        m.searchIcon.blendColor = ColorPalette.PRIMARY
        m.avatarFocusRing.visible = false
    else
        m.searchIcon.blendColor = ColorPalette.TEXT_SECONDARY
        m.avatarFocusRing.visible = true
    end if
end sub

sub onFocusedIndexChange()
    updateHighlight()
end sub

sub refreshHighlight()
    updateHighlight()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if isStringEqual(key, KeyCode.LEFT)
        if m.top.focusedIndex > 0
            m.top.focusedIndex = m.top.focusedIndex - 1
        end if
        return true
    end if

    if isStringEqual(key, KeyCode.RIGHT)
        if m.top.focusedIndex < 1
            m.top.focusedIndex = m.top.focusedIndex + 1
        end if
        return true
    end if

    if isStringEqual(key, KeyCode.OK)
        if m.top.focusedIndex = 0
            m.top.getScene().jumpTo = { selectionType: "search" }
        else
            m.top.getScene().jumpTo = { selectionType: "profile" }
        end if
        return true
    end if

    return false
end function

<?xml version="1.0" encoding="utf-8"?>
<component name="OcelotlHome" extends="JFScreen">
  <children>
    <Poster id="backdropA" loadDisplayMode="scaleToZoom" width="1920" height="1080" opacity="0" />
    <Poster id="backdropB" loadDisplayMode="scaleToZoom" width="1920" height="1080" opacity="0" />
    <Rectangle id="backdropOverlay" width="1920" height="1080" opacity="0" />
    <OcelotlSidebar
      id="sidebar"
      translation="[0,0]" />
    <LayoutGroup id="buttons" translation="[860, 100]" layoutDirection="horiz" horizAlignment="left" itemSpacings="[25]">
      <TextButton
        id="searchButton"
        iconSide="left"
        fontSize="30"
        padding="24"
        icon="pkg:/images/ocelotl/icons/search.png"
        focusIcon="pkg:/images/ocelotl/icons/search.png"
        text="Search"
        height="60"
        width="230"
        scaleRotateCenter="[115, 30]" />
    </LayoutGroup>

    <HomeRows
      id="homeRows"
      showRowLabel="true"
      vertFocusAnimationStyle="fixedFocus"
      rowFocusAnimationStyle="fixedFocus"
      itemComponentName="HomeItem"
      numRows="2"
      rowLabelOffset="[[0,20]]" />
    <OptionsSlider id="options" />

    <Animation id="toggleButtonsAnimation" duration=".7" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="buttonsFade" key="[0.0, .6]" keyValue="[1.00, 0.00]" fieldToInterp="buttons.opacity" />
      <Vector2DFieldInterpolator id="buttonsMove" key="[0.1, .9]" keyValue="[[860, 100], [860, 0]]" fieldToInterp="buttons.translation" />
    </Animation>
    <Animation id="backdropCrossfadeAnimation" duration=".5" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="backdropAFade" key="[0.0, 1.0]" keyValue="[0.00, 1.00]" fieldToInterp="backdropA.opacity" />
      <FloatFieldInterpolator id="backdropBFade" key="[0.0, 1.0]" keyValue="[0.00, 1.00]" fieldToInterp="backdropB.opacity" />
      <FloatFieldInterpolator id="backdropOverlayFade" key="[0.0, 1.0]" keyValue="[0.00, 1.00]" fieldToInterp="backdropOverlay.opacity" />
    </Animation>
    <Animation id="sidebarPushAnimation" duration=".2" repeat="false" easeFunction="linear">
      <Vector2DFieldInterpolator
        id="sidebarPushInterpolator"
        key="[0.0,1.0]"
        keyValue="[[150,140],[150,140]]"
        fieldToInterp="homeRows.translation" />
    </Animation>
    <Animation id="searchButtonScaleAnimation" duration=".15" repeat="false" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="searchButtonScale" key="[0.0, 1.0]" keyValue="[[1.0, 1.0], [1.1, 1.1]]" fieldToInterp="searchButton.scale" />
    </Animation>
  </children>
  <interface>
    <field id="playlistData" type="array" />
    <field id="selectedItem" alias="homeRows.selectedItem" />
    <field id="rowFocused" alias="homeRows.itemFocused" onchange="onRowFocusedChange" />
    <field id="quickPlayNode" alias="homeRows.quickPlayNode" />
    <function name="refresh" />
    <function name="loadLibraries" />
    <field id="homeItemFocused" alias="homeRows.rowItemFocused" onchange="onHomeItemFocusedChange" />
  </interface>
</component>
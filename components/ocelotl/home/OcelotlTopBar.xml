<?xml version="1.0" encoding="utf-8"?>
<component name="OcelotlTopBar" extends="Group">
    <children>
        <Label id="logo" text="OCELOTL" translation="[48, 24]" font="font:LargeSystemFont" color="#FFFFFF" />

        <Poster id="searchIcon" translation="[1580, 40]" width="48" height="48" uri="pkg:/images/icons/search-light.png" />
        <Poster id="settingsIcon" translation="[1660, 40]" width="48" height="48" uri="pkg:/images/icons/settings.png" />
        <Label id="clock" text="" translation="[1770, 40]" font="font:MediumSystemFont" color="#FFFFFF" />

        <Timer id="clockTimer" repeat="true" duration="30" control="start" />
    </children>
    <interface>
        <field id="focusedIndex" type="integer" value="0" alwaysNotify="true" onChange="onFocusedIndexChange" />
        <field id="itemSelected" type="integer" alwaysNotify="true" />
        <function name="refreshHighlight" />
    </interface>
</component>
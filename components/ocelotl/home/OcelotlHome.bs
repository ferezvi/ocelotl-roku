import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/AnimationControl.bs"
import "pkg:/source/enums/AnimationState.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ImageType.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/SidebarLayout.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.isFirstRun = true
    m.top.overhangTitle = ""
    m.top.optionsAvailable = false
    m.zone = "content"

    m.postTask = createObject("roSGNode", "PostTask")

    m.favoritesOptionText = tr("Add To Favorites")

    m.loadItemsTask1 = createObject("roSGNode", "LoadItemsTask")
    m.loadItemsTask1.observeField("content", "onMyListLoaded")
    m.loadItemsTask1.itemsToLoad = "isInMyList"

    m.loadMetaDataTask = CreateObject("roSGNode", "LoadItemsTask")
    m.loadMetaDataTask.itemsToLoad = "metaData"
    m.loadMetaDataTask.observeField("content", "onMetaDataLoaded")

    m.homeRows = m.top.findNode("homeRows")
    m.homeRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    m.homeRows.observeField("libraries", "onLibrariesChanged")
    m.sidebar = m.top.findNode("sidebar")
    m.sidebar.observeField("expanded", "onSidebarExpandedChange")

    m.pushAnimation = m.top.findNode("sidebarPushAnimation")
    m.pushInterpolator = m.top.findNode("sidebarPushInterpolator")
    m.sidebar.observeField("itemSelected", "onSidebarItemSelected")

    m.backdropA = m.top.findNode("backdropA")
    m.backdropB = m.top.findNode("backdropB")
    m.backdropA.observeField("loadStatus", "onBackdropLoaded")
    m.backdropB.observeField("loadStatus", "onBackdropLoaded")

    m.backdropOverlay = m.top.findNode("backdropOverlay")
    m.backdropOverlay.color = ColorPalette.BACKDROP_OVERLAY
    m.backdropOverlayFade = m.top.findNode("backdropOverlayFade")

    ' Poster currently shown vs. the one used to preload the next image
    m.activeBackdrop = m.backdropA
    m.inactiveBackdrop = m.backdropB

    m.backdropCrossfadeAnimation = m.top.findNode("backdropCrossfadeAnimation")
    m.backdropAFade = m.top.findNode("backdropAFade")
    m.backdropBFade = m.top.findNode("backdropBFade")

    ' Tracks which node's load event we're waiting on, to ignore stale
    ' events from rapid navigation
    m.pendingBackdropTarget = invalid

    m.buttons = m.top.findNode("buttons")
    m.toggleButtonsAnimation = m.top.findNode("toggleButtonsAnimation")
    m.buttonsFade = m.top.findNode("buttonsFade")
    m.buttonsMove = m.top.findNode("buttonsMove")

    m.searchButtonScale = m.top.findNode("searchButtonScale")
    m.searchButtonScaleAnimation = m.top.findNode("searchButtonScaleAnimation")

    setButtonColors()
    m.searchButton.observeField("focus", "onSearchButtonFocusChange")
end sub

sub onSearchButtonFocusChange()
    m.searchButtonScale.reverse = not m.searchButton.focus
    m.searchButtonScaleAnimation.control = "start"
end sub

sub onSidebarExpandedChange()

    fromPos = m.homeRows.translation

    collapsedX = SidebarLayout.SCREEN_MARGIN + SidebarLayout.COLLAPSED_WIDTH + SidebarLayout.CONTENT_MARGIN
    toX = collapsedX

    if m.sidebar.expanded
        toX = collapsedX + (SidebarLayout.EXPANDED_WIDTH - SidebarLayout.COLLAPSED_WIDTH)
    end if

    m.pushInterpolator.keyValue = [fromPos, [toX, 140]]
    m.pushAnimation.control = "start"

end sub

sub onLibrariesChanged()
    m.sidebar.libraries = m.homeRows.libraries
end sub

sub refresh()
    m.homeRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
    m.homeRows.callFunc("updateHomeRows")
end sub

sub setButtonColors()
    m.searchButton = m.top.findNode("searchButton")
    m.searchButton.textColor = ColorPalette.WHITE
    m.searchButton.background = ColorPalette.TRANSPARENT
    m.searchButton.focusTextColor = ColorPalette.WHITE
    m.searchButton.focusBackground = ColorPalette.PRIMARY
end sub

sub loadLibraries()
    m.homeRows.callFunc("loadLibraries")
end sub

' JFScreen hook called when the screen is displayed by the screen manager
sub OnScreenShown()
    m.homeRows.rowLabelColor = chainLookupReturn(m.global.session, "user.settings.colorHomeRowHeaders", ColorPalette.WHITE)

    scene = m.top.getScene()
    overhang = scene.findNode("overhang")
    if isValid(overhang)
        overhang.visible = true
        overhang.title = ""
        overhang.currentUserProfileImage = UserImageURL(m.global.session.user.id)
        overhang.currentUser = m.global.session.user.name
    end if

    if isValid(m.top.lastFocus)
        if LCase(m.top.lastFocus.id) = "overhang"
            overhang.callFunc("highlightUser")
        end if
        m.top.lastFocus.setFocus(true)
    else
        m.top.setFocus(true)
        group = m.global.sceneManager.callFunc("getActiveScene")
        group.lastFocus = m.top
    end if

    if not m.isFirstRun
        if m.homeRows.callFunc("isFocusOnFavoriteRow")
            m.homeRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
            m.homeRows.callFunc("reloadFavorites")
        else
            refresh()
        end if
    end if

    ' post the device profile the first time this screen is loaded
    if m.isFirstRun
        m.isFirstRun = false
        m.postTask.arrayData = getDeviceCapabilities()
        m.postTask.apiUrl = "/Sessions/Capabilities/Full"
        m.postTask.control = "RUN"
        m.postTask.observeField("responseCode", "postFinished")
    end if
end sub

' JFScreen hook called when the screen is hidden by the screen manager
sub OnScreenHidden()
    scene = m.top.getScene()
    overhang = scene.findNode("overhang")
    if isValid(overhang)
        overhang.callFunc("dehighlightUser")
        overhang.currentUser = ""
        overhang.title = ""
    end if
end sub

' Triggered by m.postTask after completing a post.
' Empty the task data when finished.
sub postFinished()
    m.postTask.unobserveField("responseCode")
    m.postTask.callFunc("empty")
end sub

sub onRowFocusedChange()
    if m.top.rowFocused > 0
        if m.buttons.opacity > 0
            toggleButtonsVisibility()
        end if
        return
    end if

    if m.buttons.opacity < 1
        toggleButtonsVisibility(true)
    end if
end sub

sub toggleButtonsVisibility(runInReverse = false as boolean)
    m.buttonsFade.reverse = runInReverse
    m.buttonsMove.reverse = runInReverse

    if not isStringEqual(m.toggleButtonsAnimation.state, AnimationState.RUNNING)
        m.toggleButtonsAnimation.control = AnimationControl.START
    end if
end sub

sub setBackdropImage(backdropUri as string)

    if backdropUri = ""
        startBackdropFade(m.activeBackdrop, invalid)
        return
    end if

    ' Already showing this backdrop at full opacity - nothing to do
    if backdropUri = m.activeBackdrop.uri and m.activeBackdrop.opacity = 1.0
        return
    end if

    ' Same image, currently faded out (focus moved away then came back) -
    ' just fade it back in, no reload needed
    if backdropUri = m.activeBackdrop.uri
        startBackdropFade(m.inactiveBackdrop, m.activeBackdrop)
        return
    end if

    ' Already preloaded in the inactive poster (e.g. navigating back a step)
    if backdropUri = m.inactiveBackdrop.uri and m.inactiveBackdrop.loadStatus = "ready"
        startBackdropFade(m.activeBackdrop, m.inactiveBackdrop)
        return
    end if

    m.inactiveBackdrop.uri = backdropUri
    m.pendingBackdropTarget = m.inactiveBackdrop

end sub

sub onBackdropLoaded(event as object)
    node = event.GetRoSGNode()

    ' Ignore load events from a backdrop that's no longer the pending target
    if not isValid(m.pendingBackdropTarget) then return
    if not node.isSameNode(m.pendingBackdropTarget) then return
    if node.loadStatus <> "ready" then return

    startBackdropFade(m.activeBackdrop, node)
end sub

' Crossfades between the two backdrop posters. If incoming is invalid,
' just fades the outgoing poster to black (used to clear the backdrop).
sub startBackdropFade(outgoing as object, incoming = invalid as dynamic)

    if isStringEqual(m.backdropCrossfadeAnimation.state, AnimationState.RUNNING)
        m.backdropCrossfadeAnimation.control = AnimationControl.STOP
    end if

    m.backdropAFade.keyValue = [m.backdropA.opacity, m.backdropA.opacity]
    m.backdropBFade.keyValue = [m.backdropB.opacity, m.backdropB.opacity]

    if isValid(incoming)
        outgoingInterpolator = outgoing.isSameNode(m.backdropA) ? m.backdropAFade : m.backdropBFade
        outgoingInterpolator.keyValue = [outgoing.opacity, 0.0]

        incomingInterpolator = incoming.isSameNode(m.backdropA) ? m.backdropAFade : m.backdropBFade
        incomingInterpolator.keyValue = [incoming.opacity, 1.0]

        m.backdropOverlayFade.keyValue = [m.backdropOverlay.opacity, 1.0]

        m.activeBackdrop = incoming
        m.inactiveBackdrop = outgoing
    else
        ' Clearing: fade BOTH posters to 0. Either one could be mid-fade
        ' (frozen at a stale opacity) if a previous crossfade was
        ' interrupted, so we can't just target "outgoing"
        m.backdropAFade.keyValue = [m.backdropA.opacity, 0.0]
        m.backdropBFade.keyValue = [m.backdropB.opacity, 0.0]

        m.backdropOverlayFade.keyValue = [m.backdropOverlay.opacity, 0.0]
    end if

    m.pendingBackdropTarget = invalid
    m.backdropCrossfadeAnimation.control = AnimationControl.START
end sub

sub onHomeItemFocusedChange()
    if not isValid(m.homeRows.rowItemFocused) then return

    row = m.homeRows.rowItemFocused[0]
    col = m.homeRows.rowItemFocused[1]

    focusedItem = m.homeRows.content.getChild(row).getChild(col)
    if not isValid(focusedItem) then return

    ' Request backdrop at the device's actual resolution to avoid
    ' loading an oversized FHD texture on HD devices
    isHD = chainLookupReturn(m.global.device, "isHDDevice", false)
    backdropWidth = isHD ? "1280" : "1920"
    backdropHeight = isHD ? "720" : "1080"

    if isValid(focusedItem.json)

        ' Movies / Series with their own backdrop
        if isValidAndNotEmpty(focusedItem.json.BackdropImageTags)
            backdrop = ImageURL(focusedItem.id, ImageType.BACKDROP, {
                maxHeight: backdropHeight,
                maxWidth: backdropWidth,
                quality: "90"
            })

            if backdrop <> ""
                setBackdropImage(backdrop)
                return
            end if
        end if

        ' Music albums: own backdrop -> artist backdrop -> album art fallback
        if focusedItem.type = "MusicAlbum" or focusedItem.type = "Audio"

            if isValidAndNotEmpty(focusedItem.json.BackdropImageTags)
                backdrop = ImageURL(focusedItem.id, ImageType.BACKDROP, {
                    maxHeight: backdropHeight,
                    maxWidth: backdropWidth,
                    quality: "90"
                })

                if backdrop <> ""
                    setBackdropImage(backdrop)
                    return
                end if
            end if

            if isValidAndNotEmpty(focusedItem.json.AlbumArtists)
                artistId = focusedItem.json.AlbumArtists[0].Id

                if isValidAndNotEmpty(artistId)
                    artistBackdrop = ImageURL(artistId, ImageType.BACKDROP, {
                        maxHeight: backdropHeight,
                        maxWidth: backdropWidth,
                        quality: "90"
                    })

                    if artistBackdrop <> ""
                        setBackdropImage(artistBackdrop)
                        return
                    end if
                end if
            end if

            if isValidAndNotEmpty(focusedItem.json.ImageTags)
                albumArt = ImageURL(focusedItem.id, ImageType.PRIMARY, {
                    maxHeight: backdropHeight,
                    maxWidth: backdropWidth,
                    quality: "90"
                })

                if albumArt <> ""
                    setBackdropImage(albumArt)
                    return
                end if
            end if

        end if

        ' Episodes use the parent series' backdrop
        if focusedItem.type = "Episode" and isValidAndNotEmpty(focusedItem.json.seriesid)
            backdrop = ImageURL(focusedItem.json.seriesid, ImageType.BACKDROP, {
                maxHeight: backdropHeight,
                maxWidth: backdropWidth,
                quality: "90"
            })

            if backdrop <> ""
                setBackdropImage(backdrop)
                return
            end if
        end if

    end if

    ' No backdrop available: clear previous image
    setBackdropImage("")
end sub

sub onMyListLoaded()
    isInMyListData = m.loadItemsTask1.content
    m.loadItemsTask1.content = []

    if not isValidAndNotEmpty(isInMyListData) then return

    focusedItem = m.homeRows.content.getChild(m.homeRows.rowItemFocused[0]).getChild(m.homeRows.rowItemFocused[1])
    if not isValid(focusedItem) then return

    dialogData = []
    paramData = {
        id: focusedItem.LookupCI("id")
    }

    if isInMyListData[0]
        dialogData.push(tr("Remove From My List"))
    else
        if inArray([ItemType.EPISODE, ItemType.MOVIE, ItemType.SEASON, ItemType.SERIES, ItemType.VIDEO, ItemType.MUSICVIDEO, ItemType.RECORDING, ItemType.BOXSET], focusedItem.LookupCI("type"))
            dialogData.push(tr("Add To My List"))
        end if
    end if

    if not inArray([ItemType.RADIOSTATION], focusedItem.LookupCI("type"))
        dialogData.push(m.favoritesOptionText)
    end if

    if not inArray([ItemType.COLLECTIONFOLDER, ItemType.RADIOSTATION, ItemType.CHANNEL, ItemType.FOLDER, ItemType.PLAYLIST, ItemType.PROGRAM, ItemType.TVCHANNEL, ItemType.USERVIEW], focusedItem.LookupCI("type"))
        dialogData.push(tr("Add To Playlist"))
    end if

    if inArray([ItemType.EPISODE, ItemType.MOVIE, ItemType.SEASON, ItemType.SERIES, ItemType.VIDEO, ItemType.MUSICVIDEO, ItemType.RECORDING, ItemType.BOXSET, ItemType.AUDIOBOOK, ItemType.BOOK], focusedItem.LookupCI("type"))
        showBothOptions = false
        if isChainValid(focusedItem, "PlayedPercentage")
            if focusedItem.PlayedPercentage > 0
                showBothOptions = true
            end if
        end if

        if showBothOptions
            dialogData.push(tr("Mark As Unplayed"))
            dialogData.push(tr("Mark As Played"))
        else
            if isChainValid(focusedItem, "isWatched")
                if focusedItem.isWatched
                    dialogData.push(tr("Mark As Unplayed"))
                else
                    dialogData.push(tr("Mark As Played"))
                end if
            end if
        end if
    end if

    if inArray([ItemType.EPISODE, ItemType.SEASON], focusedItem.LookupCI("type"))
        dialogData.push(tr("Go To Series"))
        dialogData.push(tr("Go To Season"))
        paramData.SeasonId = focusedItem.json.LookupCI("SeasonId")
        paramData.SeriesId = focusedItem.json.LookupCI("SeriesId")
    end if

    if inArray([ItemType.MUSICALBUM], focusedItem.LookupCI("type"))
        dialogData.push(tr("Play Instant Mix"))
        dialogData.push(tr("Go To Artist"))

        genreData = focusedItem.json.LookupCI("Genre")
        if isValidAndNotEmpty(genreData)
            if isValidAndNotEmpty(genreData[0])
                if isValidAndNotEmpty(genreData[0].Name)
                    dialogData.push(tr("Go To Genre") + `: ${genreData[0].LookupCI("Name")}`)
                    paramData.GenreName = genreData[0].LookupCI("Name")
                    paramData.GenreId = genreData[0].LookupCI("Id")
                    paramData.LibraryId = chainLookup(focusedItem, "json.LibraryId")
                end if
            end if
        end if

        paramData.ArtistId = focusedItem.json.LookupCI("AlbumArtistId")
        paramData.ArtistName = focusedItem.json.LookupCI("albumartist")
        paramData.AlbumId = focusedItem.LookupCI("id")
    end if

    m.global.sceneManager.callFunc("optionDialog", "libraryitem", focusedItem.LookupCI("title") ?? tr("Options"), [], dialogData, paramData)
end sub

sub setLastFocus(lastFocusElement)
    group = m.global.sceneManager.callFunc("getActiveScene")

    if isValid(group)
        group.lastFocus = lastFocusElement
    end if
end sub

function audioMiniPlayerIsVisibleInScene()
    scene = m.top.getScene()
    audioMiniPlayer = scene.findNode("audioMiniPlayer")

    if not isValid(audioMiniPlayer) then return false

    return audioMiniPlayer.callFunc("isVisible")
end function

' Special handling for key presses on the home screen.
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' Return focus to home content from sidebar
    if isStringEqual(m.zone, "sidebar")

        if isStringEqual(key, KeyCode.RIGHT)

            m.zone = "content"
            m.homeRows.setFocus(true)
            setLastFocus(m.homeRows)

            return true

        end if

        return false

    end if

    if isStringEqual(m.zone, "content")

        ' Handle focus navigation for the top search button
        if m.buttons.isInFocusChain()

            if isStringEqual(key, KeyCode.REPLAY)
                if not audioMiniPlayerIsVisibleInScene() then return true
                m.searchButton.focus = false
            end if

            if isStringEqual(key, KeyCode.OK)

                if m.searchButton.hasFocus()
                    m.top.getScene().jumpTo = {
                        selectionType: "search"
                    }
                    return true
                end if

            end if


            if isStringEqual(key, KeyCode.DOWN)
                m.searchButton.focus = false
                m.homeRows.setFocus(true)
                setLastFocus(m.homeRows)
                return true
            end if


            if isStringEqual(key, KeyCode.RIGHT)

                if m.searchButton.hasFocus()

                    m.searchButton.focus = false

                    scene = m.top.getScene()
                    if not isValid(scene) then return false

                    overhang = scene.findNode("overhang")
                    if not isValid(overhang) then return false

                    overhang.callFunc("highlightUser")
                    overhang.setFocus(true)
                    setLastFocus(overhang)

                    return true
                end if

            end if

            return false

        end if

        ' Move focus to sidebar when pressing left from the first item in a row
        if isStringEqual(key, KeyCode.LEFT)

            rowItemFocused = chainLookupReturn(m.homeRows, "rowItemFocused", [0, 0])

            if isNumber(rowItemFocused[1]) and rowItemFocused[1] = 0
                m.zone = "sidebar"

                ' Clear backdrop immediately when opening sidebar
                setBackdropImage("")

                m.sidebar.setFocus(true)
                setLastFocus(m.sidebar)
                m.sidebar.callFunc("refreshHighlight")

                return true
            end if

        end if


        ' Move back to the first item in the current row
        if isStringEqual(key, KeyCode.BACK)

            rowItemFocused = chainLookupReturn(m.homeRows, "rowItemFocused", [0, 0])

            if isNumber(rowItemFocused[1])

                if rowItemFocused[1] > 0
                    m.homeRows.jumpToRowItem = [rowItemFocused[0], 0]
                    return true
                end if

            end if

        end if


        ' Options
        if isStringEqual(key, KeyCode.OPTIONS)

            if m.homeRows.hasFocus()

                focusedItem = m.homeRows.content.getChild(m.homeRows.rowItemFocused[0]).getChild(m.homeRows.rowItemFocused[1])

                if not isValidAndNotEmpty(focusedItem) then return false

                m.loadMetaDataTask.itemId = focusedItem.LookupCI("id")
                m.loadMetaDataTask.control = TaskControl.RUN

                return true

            end if

        end if

        ' Move focus back to the top search button
        if isStringEqual(key, KeyCode.UP)

            if m.buttons.opacity < 1
                toggleButtonsVisibility(true)
            end if

            ' Buttons have no associated backdrop, so clear it (fades out via
            ' the existing crossfade animation instead of cutting abruptly)
            setBackdropImage("")

            m.searchButton.focus = true
            m.searchButton.setFocus(true)
            setLastFocus(m.searchButton)

            return true

        end if

    end if


    return false

end function

sub onMetaDataLoaded()
    data = m.loadMetaDataTask.content[0]

    m.favoritesOptionText = chainLookupReturn(data, "json.UserData.IsFavorite", false) ? tr("Remove From Favorites") : tr("Add To Favorites")

    focusedItem = m.homeRows.content.getChild(m.homeRows.rowItemFocused[0]).getChild(m.homeRows.rowItemFocused[1])

    m.loadItemsTask1.itemId = focusedItem.LookupCI("id")
    m.loadItemsTask1.control = TaskControl.RUN
end sub

sub onSidebarItemSelected()
    selectedId = m.sidebar.itemSelected

    if isStringEqual(selectedId, "settings")
        m.top.getScene().jumpTo = {
            selectionType: "settings"
        }
        return
    end if

    ' TODO: "home" and library ids aren't wired up yet either -
    ' out of scope for this change, flagging for follow-up
end sub

<?xml version="1.0" encoding="utf-8"?>

<component name="PlayerControls" extends="Group">

    <interface>
        <field id="hasFocus" type="boolean" alwaysNotify="true" />
        <field id="action" type="string" alwaysNotify="true" />
        <field id="playbackState" type="string" alwaysNotify="true" />
        <function name="focusDefaultButton" />
    </interface>

    <children>
        <ButtonGroup id="videoControls"
            itemSpacings="[20, 420, 20, 20, 20, 20]"
            layoutDirection="horiz"
            horizAlignment="left"
            translation="[96, 940]">
            <MediaButton id="showVideoOverviewPopup" icon="pkg:/images/ocelotl/icons/info.png" slotSize="96" backgroundSize="84" iconSize="36" />
            <MediaButton id="languageButton" icon="pkg:/images/ocelotl/icons/languages.png" slotSize="96" backgroundSize="84" iconSize="36" />
            <MediaButton id="itemBack" icon="pkg:/images/ocelotl/icons/skip-back.png" slotSize="96" backgroundSize="84" iconSize="48" />
            <MediaButton id="chapterBack" icon="pkg:/images/ocelotl/icons/rewind.png" slotSize="96" backgroundSize="84" iconSize="48" />
            <MediaButton id="videoPlayPause" icon="pkg:/images/ocelotl/icons/play.png" slotSize="96" backgroundSize="96" iconSize="64" />
            <MediaButton id="chapterNext" icon="pkg:/images/ocelotl/icons/fast-forward.png" slotSize="96" backgroundSize="84" iconSize="48" />
            <MediaButton id="itemNext" icon="pkg:/images/ocelotl/icons/skip-forward.png" slotSize="96" backgroundSize="84" iconSize="48" />
        </ButtonGroup>

        <Group id="content" />

    </children>

</component>
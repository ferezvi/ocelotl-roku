sub init()

    m.top.color = "0x00000000"

    m.buttonBackground = m.top.findNode("buttonBackground")
    m.buttonIcon = m.top.findNode("buttonIcon")

    m.buttonBackground.visible = false

    m.top.observeField("focus", "onFocusChanged")
    m.top.observeField("icon", "onIconChanged")
    m.top.observeField("slotSize", "onSizeChanged")
    m.top.observeField("backgroundSize", "onSizeChanged")
    m.top.observeField("iconSize", "onSizeChanged")

    onSizeChanged()

end sub


sub onSizeChanged()

    slotSize = m.top.slotSize
    backgroundSize = m.top.backgroundSize
    iconSize = m.top.iconSize

    ' Width follows the widest visual element — keeps horizontal spacing tight
    slotWidth = iconSize
    if backgroundSize > slotWidth then slotWidth = backgroundSize

    ' Height stays fixed to slotSize — keeps every button vertically centered the same way
    slotHeight = slotSize

    m.top.width = slotWidth
    m.top.height = slotHeight

    ' Background centered on both axes using their respective box
    m.buttonBackground.width = backgroundSize
    m.buttonBackground.height = backgroundSize

    m.buttonBackground.translation = [
        (slotWidth - backgroundSize) / 2,
        (slotHeight - backgroundSize) / 2
    ]

    ' Icon centered on both axes using their respective box
    m.buttonIcon.width = iconSize
    m.buttonIcon.height = iconSize

    m.buttonIcon.translation = [
        (slotWidth - iconSize) / 2,
        (slotHeight - iconSize) / 2
    ]

end sub


sub onFocusChanged()

    if m.top.focus
        m.buttonBackground.visible = true
        m.buttonBackground.blendColor = m.top.focusBackground
    else
        m.buttonBackground.visible = false
    end if

end sub


sub onIconChanged()
    m.buttonIcon.uri = m.top.icon
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if not m.top.focus then return false

    if key = "OK"
        m.top.pressed = true
        return true
    end if

    if key = "right"
        m.top.escape = "right"
    else if key = "left"
        m.top.escape = "left"
    else if key = "up"
        m.top.escape = "up"
    else if key = "down"
        m.top.escape = "down"
    end if

    return false
end function

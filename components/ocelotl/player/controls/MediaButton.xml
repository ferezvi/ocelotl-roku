<?xml version="1.0" encoding="utf-8"?>
<component name="MediaButton" extends="Rectangle">

  <children>

    <Poster
      id="buttonBackground"
      uri="pkg:/images/ocelotl/ui/buttons/focusCircle.png"
      visible="false"
      loadDisplayMode="scaleToFit"
    />

    <Poster
      id="buttonIcon"
      loadDisplayMode="scaleToFit"
    />

  </children>

  <interface>

    <field id="focusBackground" type="color" value="" />

    <field id="icon" type="string" value="" />

    <!-- Fixed hit area / measurement box used by ButtonGroup or LayoutGroup -->
    <field id="slotSize" type="integer" value="48" />

    <!-- Visual sizes, always centered inside slotSize regardless of value -->
    <field id="backgroundSize" type="integer" value="32" />
    <field id="iconSize" type="integer" value="24" />

    <field id="focus" type="boolean" />

    <field id="escape" type="string" value="" />

  </interface>

</component>
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/misc.bs"

sub init()

    findNodes()
    initFields()

end sub


sub findNodes()

    m.titleLabel = m.top.findNode("titleLabel")
    m.subtitleLabel = m.top.findNode("subtitleLabel")

end sub

sub initFields()

    m.titleLabel.text = "Prueba Ocelotl Player"
    m.subtitleLabel.text = "Subtitulo de prueba"


    m.titleLabel.color = chainLookupReturn(m.global.session, "user.settings.colorText", ColorPalette.TEXT_PRIMARY)
    m.subtitleLabel.color = chainLookupReturn(m.global.session, "user.settings.colorSubText", ColorPalette.TEXT_SECONDARY)

end sub


sub onPlaybackStateChanged()

    print "OcelotlPlayerOSD state: "; m.top.playbackState

end sub


sub onControlAction()

    if m.controls.action <> ""
        m.top.action = m.controls.action
    end if

end sub

sub show()

    m.top.visible = true

end sub


sub hide()

    m.top.visible = false

end sub

<?xml version="1.0" encoding="utf-8"?>

<component name="OcelotlPlayerOSD" extends="Group">

    <interface>
        <field id="hasFocus" type="boolean" alwaysNotify="true" />
        <field id="action" type="string" alwaysNotify="true" />
        <field id="playbackState" type="string" alwaysNotify="true" />
        <field id="logoImage" type="string" />
        <field id="itemTitleText" type="string" />
        <field id="itemSubtitleText" type="string" />
        <field id="seasonNumber" type="integer" />
        <field id="episodeNumber" type="integer" />
        <field id="episodeNumberEnd" type="integer" />
        <function name="show" />
        <function name="hide" />
    </interface>

    <children>

        <Poster id="topGradient" uri="pkg:/images/ocelotl/ui/osd/top_gradient.png" width="1920" height="260" translation="[0,0]" />
        <Poster id="bottomGradient" uri="pkg:/images/ocelotl/ui/osd/bottom_gradient.png" width="1920" height="300" translation="[0,780]" />

        <LayoutGroup id="videoInfo" layoutDirection="horiz" translation="[103,61]" itemSpacings="[24]">
            <Poster id="logoImage" loadDisplayMode="scaleFit" />
            <LayoutGroup id="titleInfo" layoutDirection="vert">
                <ScrollingText id="itemTitle" font="font:LargeBoldSystemFont" />
                <Text id="itemSubtitle" font="font:MediumSystemFont" />
                <LayoutGroup id="episodeInfo" layoutDirection="horiz" itemSpacings="[12]">
                    <Text id="itemSeason" font="font:MediumSystemFont" />
                    <Text id="itemEpisode" font="font:MediumSystemFont" />
                    <Text id="itemEpisodeEnd" font="font:MediumSystemFont" />
                </LayoutGroup>
            </LayoutGroup>
        </LayoutGroup>

        <Clock id="clock" translation="[1600,50]" />

        <Group id="content">

            <OcelotlPlayerControls
                id="controls"
            />

        </Group>

    </children>

</component>